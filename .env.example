# Meterlex — hub settings
# Copy this file to ".env"; docker compose reads it automatically.
#
# The hub no longer reads session logs itself: every machine, this one
# included, runs collector/meterlex_collector.py, which POSTs token counts to
# /api/ingest with that machine's key (see README › Add a machine).

# The machine the hub's stored history came from, before collectors reported
# per machine. Use the name this machine's collector reports under.
HUB_MACHINE=my-desktop

# The model-prices app as a browser can reach it — the Prices screen links there
# instead of rendering its own table. Leave empty to hide the link.
PRICES_URL=

# The zone periods are counted in: a week starts Monday 00:00 here, and a day
# at local midnight. Rows stay stored in UTC.
LOCAL_TZ=Europe/Paris

# The openclaw-spend app as a browser can reach it — the More screen links
# there for per-agent detail. Leave empty to hide the link.
OPENCLAW_SPEND_URL=
