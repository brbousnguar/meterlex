# Meterlex — host source paths
# Copy this file to ".env" and adjust to your machine.
# docker compose reads .env automatically from this directory.
#
# These are bind-mounted READ-ONLY into the backend container so the scanner
# can read your coding tools' session logs. Use forward slashes on Windows
# (Docker Desktop accepts them). If a directory does not exist, leave it set —
# the mount will simply be empty and that source will show no data.

CLAUDE_CODE_PROJECTS=C:/Users/your-username/.claude/projects
CODEX_SESSIONS=C:/Users/your-username/.codex/sessions
AGY_DIR=C:/Users/your-username/.gemini/antigravity-cli
# GitHub Copilot CLI (agentic `copilot` binary) — token totals in data.db
COPILOT_CLI_DIR=C:/Users/your-username/.copilot
